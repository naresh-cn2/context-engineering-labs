# Python bytecode / compiled
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
.env/
.venv*/

# Environment / secret files
.env
.env.*
!.env.example

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.coverage.*
noxfile.py

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# OS
*.log
